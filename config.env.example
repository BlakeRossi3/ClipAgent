# Auto Shorts Agent configuration.
# Copy to `config.env` (gitignored) and fill in. Real environment variables
# override values in this file. Relative paths are resolved against the repo root.

# ---------------------------------------------------------------- paths ----
# Root for the SQLite DB, OAuth token and media (default: ./data)
CLIPAGENT_DATA_DIR=data
# Override the SQLite path (default: $CLIPAGENT_DATA_DIR/clipagent.db)
CLIPAGENT_DB_PATH=
# Media root; downloads/, transcripts/, renders/ live under it (default: $CLIPAGENT_DATA_DIR/media)
CLIPAGENT_MEDIA_DIR=
# The live strategy file (default: ./strategy.json)
CLIPAGENT_STRATEGY_PATH=
# Alternative config file location (only meaningful as a real env var)
# CLIPAGENT_CONFIG_FILE=config.env

# ------------------------------------------------------------ Anthropic ----
# Required unless FAKE_LLM=true. llm.py passes this key explicitly; no other
# credential source (ANTHROPIC_AUTH_TOKEN, ant profiles) is ever used.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Cheap first-pass scorer and the judgment model.
HAIKU_MODEL=claude-haiku-5-5
SONNET_MODEL=claude-sonnet-5-5
# output_config.effort per tier (low | medium | high | xhigh | max)
HAIKU_EFFORT=low
SONNET_EFFORT=medium
# SDK-level retries for 429/5xx/connection errors, and request timeout (seconds)
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SEC=120
# Sonnet calls opt into server-side refusal fallbacks (beta). true/false
LLM_SERVER_FALLBACKS=true
# Optional price overrides, USD per million tokens, as JSON:
# {"claude-haiku-5-5": {"input": 0.10, "output": 0.50, "cache_write": 0.125, "cache_read": 0.01}}
LLM_PRICES_JSON=
# true = never call Anthropic; llm.complete() returns deterministic fake output.
FAKE_LLM=false

# ----------------------------------------------------------- guardrails ----
# Baseline daily LLM spend cap (USD). strategy.json `daily_llm_budget_usd`
# overrides it, but the effective cap never exceeds MAX_DAILY_LLM_BUDGET_USD.
DAILY_LLM_BUDGET_USD=1.00
MAX_DAILY_LLM_BUDGET_USD=5.00
# Hard upload cap per local day. One videos.insert costs ~1600 quota units of
# the default 10,000/day, so keep this <= 6.
MAX_UPLOADS_PER_DAY=6
# true = nothing external is contacted for uploads, calls or SMS; actions are
# recorded in the DB as dry runs. Defaults to true; set false to go live.
DRY_RUN=true

# -------------------------------------------------------------- YouTube ----
# OAuth "Desktop app" client secrets from Google Cloud console
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Where the authorised user token is cached (default: $CLIPAGENT_DATA_DIR/youtube_token.json)
YOUTUBE_TOKEN_PATH=
# private | unlisted | public. Scheduled uploads are private until publishAt.
YOUTUBE_DEFAULT_PRIVACY=private
# 28 = Science & Technology
YOUTUBE_CATEGORY_ID=28

# --------------------------------------------------------------- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=
OWNER_PHONE=
OWNER_NAME=Blake
# Public HTTPS URL where server.py is reachable (Twilio webhooks), no trailing slash
PUBLIC_BASE_URL=http://localhost:8000
# Optional shared secret for the dashboard (?token=... or Bearer header)
DASHBOARD_TOKEN=

# ----------------------------------------------------------------- misc ----
# IANA timezone used for "today" (budget, upload cap) and posting times
TIMEZONE=America/New_York
# faster-whisper model size / device (auto|cpu|cuda) / compute type (int8, float16, ...)
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
FFMPEG_BIN=ffmpeg
LOG_LEVEL=INFO
