# Auto Shorts Agent configuration.
# Copy to `config.env` (gitignored) and fill in. Real environment variables
# override values in this file. Relative paths are resolved against the repo root.

# ---------------------------------------------------------------- paths ----
# Root for the SQLite DB, OAuth token and media (default: ./data)
CLIPAGENT_DATA_DIR=data
# Override the SQLite path (default: $CLIPAGENT_DATA_DIR/clipagent.db)
CLIPAGENT_DB_PATH=
# Media root; downloads/, transcripts/, renders/ live under it (default: $CLIPAGENT_DATA_DIR/media)
CLIPAGENT_MEDIA_DIR=
# The live strategy file (default: ./strategy.json)
CLIPAGENT_STRATEGY_PATH=
# Alternative config file location (only meaningful as a real env var). Default: $CLIPAGENT_DATA_DIR/config.env
# when CLIPAGENT_DATA_DIR is set as a real env var (the Windows launcher does), else ./config.env.
# CLIPAGENT_CONFIG_FILE=config.env
# false until the web setup wizard (/setup) is finished; unset = finished if this file exists.
# SETUP_COMPLETE=true

# ------------------------------------------------------------ Anthropic ----
# Required unless FAKE_LLM=true. llm.py passes this key explicitly; no other
# credential source (ANTHROPIC_AUTH_TOKEN, ant profiles) is ever used.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Cheap first-pass scorer and the judgment model.
HAIKU_MODEL=claude-haiku-5-5
SONNET_MODEL=claude-sonnet-5-5
# output_config.effort per tier (low | medium | high | xhigh | max)
HAIKU_EFFORT=low
SONNET_EFFORT=medium
# SDK-level retries for 429/5xx/connection errors, and request timeout (seconds)
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SEC=120
# Sonnet calls opt into server-side refusal fallbacks (beta). true/false
LLM_SERVER_FALLBACKS=true
# Optional price overrides, USD per million tokens, as JSON:
# {"claude-haiku-5-5": {"input": 0.10, "output": 0.50, "cache_write": 0.125, "cache_read": 0.01}}
LLM_PRICES_JSON=
# true = never call Anthropic; llm.complete() returns deterministic fake output.
FAKE_LLM=false

# ----------------------------------------------------------- guardrails ----
# Baseline daily LLM spend cap (USD). strategy.json `daily_llm_budget_usd`
# overrides it, but the effective cap never exceeds MAX_DAILY_LLM_BUDGET_USD.
DAILY_LLM_BUDGET_USD=1.00
MAX_DAILY_LLM_BUDGET_USD=5.00
# Hard upload cap per local day. One videos.insert costs ~1600 quota units of
# the default 10,000/day, so keep this <= 6.
MAX_UPLOADS_PER_DAY=6
# true = nothing external is contacted for uploads, calls or SMS; actions are
# recorded in the DB as dry runs. Defaults to true; set false to go live.
DRY_RUN=true

# -------------------------------------------------------------- YouTube ----
# OAuth "Desktop app" client secrets from Google Cloud console
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Where the authorised user token is cached (default: $CLIPAGENT_DATA_DIR/youtube_token.json)
YOUTUBE_TOKEN_PATH=
# private | unlisted | public. Scheduled uploads are private until publishAt.
YOUTUBE_DEFAULT_PRIVACY=private
# 28 = Science & Technology
YOUTUBE_CATEGORY_ID=28
# Data API units per Pacific day for your Google Cloud project (default 10000). Raise it only
# after Google grants a quota increase; uploads stop before the local tally would exceed it.
YOUTUBE_DAILY_QUOTA=10000
# true = also collect estimated revenue + CPM per video. Needs a token authorised with
# `python youtube_auth.py --monetary` (a monetised channel); ignored otherwise.
YOUTUBE_MONETARY_ANALYTICS=false
# Optional API key (Google Cloud console -> Credentials). Only used by SCOUT_CC_BACKEND=data_api.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------- scout ----
# How CC BY YouTube videos are found: ytdlp (YouTube results page with the Creative Commons
# filter, costs no API quota) or data_api (search.list videoLicense=creativeCommon,
# 100 quota units per search; needs YOUTUBE_API_KEY).
SCOUT_CC_BACKEND=ytdlp
# Daily cap on data_api searches (each costs 100 of the 10,000 daily units uploads also use).
SCOUT_CC_API_MAX_SEARCHES_PER_DAY=2

# --------------------------------------------------------------- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=
OWNER_PHONE=
OWNER_NAME=Blake
# Public HTTPS URL where server.py is reachable (Twilio webhooks), no trailing slash
PUBLIC_BASE_URL=http://localhost:8000
# Shared secret for the dashboard (sign-in form, ?token=... once, or a Bearer header); use a
# long random value (openssl rand -hex 24). Without it the dashboard - which can approve
# strategy changes - only answers direct requests to 127.0.0.1 (an SSH tunnel), never
# requests arriving through a reverse proxy or tunnel.
DASHBOARD_TOKEN=
# true = serve the dashboard WITHOUT a password to anyone who can reach it. Only for a
# trusted private network; never on an internet-facing server.
DASHBOARD_ALLOW_UNAUTHENTICATED=false
# true = requests made directly on this machine (127.0.0.1, no proxy headers) skip DASHBOARD_TOKEN.
# The Windows launcher sets it, so the token is only needed from other devices.
DASHBOARD_TRUST_LOOPBACK=false
# Quiet hours (local time, TIMEZONE): only urgent calls ring (budget cap, YouTube login and
# copyright/takedown problems); everything else is queued until the window ends. Equal = off.
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
# At most one call per urgent kind in this many hours; repeats are texted instead.
URGENT_CALL_DEDUP_HOURS=6
# Twilio <Say> voice and language
TWILIO_VOICE=Polly.Joanna-Neural
TWILIO_LANGUAGE=en-US
# Texting channel: auto (WhatsApp while US SMS is blocked waiting for A2P 10DLC approval, else SMS),
# sms, or whatsapp. See docs/TWILIO_SETUP.md.
MESSAGING_CHANNEL=auto
# WhatsApp sender, E.164: the Twilio Sandbox number shown in the console (Messaging > Try it out >
# Send a WhatsApp message), or your own approved WhatsApp sender later. Empty = WhatsApp off.
WHATSAPP_FROM=
# The sandbox join code (the words after "join"), only used to show you instructions.
WHATSAPP_JOIN_CODE=

# ----------------------------------------------------------------- misc ----
# IANA timezone used for "today" (budget, upload cap) and posting times
TIMEZONE=America/New_York
# faster-whisper model size / device (auto|cpu|cuda) / compute type (int8, float16, ...)
WHISPER_MODEL=small.en
# cpu | cuda | auto. A failing GPU (e.g. missing cuBLAS/cuDNN DLLs on Windows) falls back to CPU int8.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
FFMPEG_BIN=ffmpeg
LOG_LEVEL=INFO

# ------------------------------------------------------------ disk hygiene ----
# Daily cleanup deletes downloaded source video/audio this many days after a source is
# done/rejected/failed (and none of its clips still needs it), and rendered Shorts this many
# days after their live upload. DB rows, info.json licence evidence and transcripts are kept.
SOURCE_MEDIA_RETENTION_DAYS=3
RENDER_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Phase 2: your personal assistant (assistant/ package). See README "Your assistant".
# Read by assistant/settings.py. Check-in times live in the vault note Agent/Routine.md.
# ---------------------------------------------------------------------------

# Master switch for inbound-SMS conversation and scheduled assistant jobs.
ASSISTANT_ENABLED=false

# What the assistant is called and how it addresses you (OWNER_NAME is shared with phase 1).
ASSISTANT_NAME=Sterling
OWNER_HONORIFIC=sir

# Models: the main agent and every sub-agent (full model ids; change here, not in code).
ASSISTANT_MODEL=claude-fable-5-2
SUBAGENT_MODEL=claude-opus-5-5
# Effort per call (low|medium|high|xhigh|max) and output ceilings (thinking counts as output).
ASSISTANT_EFFORT=medium
SUBAGENT_EFFORT=low
ASSISTANT_MAX_TOKENS=2048
SUBAGENT_MAX_TOKENS=3072
ASSISTANT_MAX_TOOL_ROUNDS=8

# Spending. SEPARATE from the pipeline's DAILY_LLM_BUDGET_USD.
# Daily cap for all assistant model calls (local day), and a ceiling for one conversation turn
# (main agent + any sub-agents it delegates to). Checked before every call, worst case.
ASSISTANT_DAILY_BUDGET_USD=3.00
ASSISTANT_MAX_TURN_USD=0.50

# Proactive texts per local day (replies to your messages do not count). Quiet hours apply.
ASSISTANT_MAX_SMS_PER_DAY=8

# Memory vault (Obsidian folder). Default: <CLIPAGENT_DATA_DIR>/vault, i.e. data/vault (git-ignored).
# Keep it outside the repository or in an ignored folder: it holds personal data.
# VAULT_DIR=/home/you/Obsidian/Assistant

# Offline deterministic runtime (no API calls). Defaults to the value of FAKE_LLM.
# FAKE_ASSISTANT=true

# Offer Anthropic's server-side web search to agents that list it (researcher). Off by default.
ASSISTANT_WEB_SEARCH=false

# --- Sterling on your Claude plan (ASSISTANT_BACKEND=claude_code): full Claude Code powers ------------
# ASSISTANT_BACKEND=claude_code
# Built-in Claude Code tools for the main agent: files, shell (PowerShell/Git Bash), web, skills,
# sub-agents, its own code (self-editing with tests + auto-rollback). false = memory tools only.
# ASSISTANT_CC_FULL=true
# Folders it may read and edit besides its own app and data folders, separated by ";".
# Empty = Desktop, Documents, Downloads, Pictures and Videos in your user profile.
# ASSISTANT_USER_DIRS=C:\Users\you\Desktop;D:\Footage
# Drive your signed-in Chrome through the Claude in Chrome extension (install it first; see docs/ASSISTANT.md).
# ASSISTANT_CHROME=false
# One full-power run may take this long (seconds) and this many tool round trips.
# ASSISTANT_CC_TASK_TIMEOUT_SEC=900
# ASSISTANT_CC_MAX_TURNS=40
# Conversation memory: one Claude Code session per channel, renewed daily or after this many turns/tokens.
# ASSISTANT_SESSION_MAX_TURNS=30
# ASSISTANT_SESSION_MAX_TOKENS=150000
# Self-editing: changes to its own code are tested, committed on a local branch and the app restarts;
# a failing test suite or health check rolls the change back. Text UNDO to revert the last one.
# ASSISTANT_SELF_EDIT=true
# ASSISTANT_SELF_EDIT_BRANCH=sterling/self
# ASSISTANT_SELF_EDIT_TEST_TIMEOUT_SEC=1200
