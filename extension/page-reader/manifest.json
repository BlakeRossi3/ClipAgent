{
  "manifest_version": 3,
  "name": "Cecil Page Reader",
  "version": "1.0.0",
  "description": "Lets Cecil (ClipAgent on this laptop) read the page you are on, only when you click the button.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Let Cecil read this page" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Let Cecil read this page"
    }
  }
}
